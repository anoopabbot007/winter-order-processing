    {
      "name": "2 - Cancellation flow",
      "item": [
        {
          "name": "01 Create a pending order for cancellation",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "http://localhost:8080/api/v1/orders",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "8080",
              "path": [
                "api",
                "v1",
                "orders"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerReference\": \"interview-customer-cancel\",\n  \"items\": [\n    {\n      \"itemName\": \"Notebook\",\n      \"quantity\": 1,\n      \"unitPrice\": 4.2\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Cancellation demo order is created', function () { pm.response.to.have.status(201); });",
                  "const body = pm.response.json();",
                  "pm.expect(body.status).to.eql('PENDING');",
                  "pm.collectionVariables.set('cancelOrderId', body.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "02 Cancel pending order",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "http://localhost:8080/api/v1/orders/{{cancelOrderId}}/cancel",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "8080",
              "path": [
                "api",
                "v1",
                "orders",
                "{{cancelOrderId}}",
                "cancel"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Pending order is cancelled', function () { pm.response.to.have.status(200); });",
                  "pm.test('Response status is CANCELLED', function () { pm.expect(pm.response.json().status).to.eql('CANCELLED'); });"
                ]
              }
            }
          ]
        }
      ]
    },
