                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Backward transition returns 409 Conflict', function () { pm.response.to.have.status(409); });",
                  "pm.test('Conflict has the API error code', function () { pm.expect(pm.response.json().code).to.eql('ORDER_CONFLICT'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "08 Reject cancellation after delivery",
          "request": {
            "method": "POST",
            "header": [],
